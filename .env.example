# Example environment configuration for the sample demo only.
# These are placeholders. Never commit real secrets.

# LLM providers (any one is enough to run the real platform; the demo uses mocks)
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Provider routing (demo)
PRIMARY_PROVIDER=gemini
FAILOVER_PROVIDERS=openai,claude
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3

# Data layer (placeholders — the demo does not connect to a real database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
